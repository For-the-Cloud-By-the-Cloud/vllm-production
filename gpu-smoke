name: gpu-smoke
on: workflow_dispatch
jobs:
  smoke:
    runs-on: gpu-t4
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4
      - run: nvidia-smi
      - run: pip install vllm
      - run: |
          vllm serve Qwen/Qwen2.5-1.5B-Instruct --dtype half --max-model-len 4096 &
          for i in $(seq 1 60); do curl -sf localhost:8000/health && break; sleep 10; done
          curl -s localhost:8000/v1/completions -H 'Content-Type: application/json' \
            -d '{"model":"Qwen/Qwen2.5-1.5B-Instruct","prompt":"Hello","max_tokens":16}'
